# Copy to .env (git-ignored) and adjust. No value here is a real secret.

# --- LLM gateway -------------------------------------------------------------
# LiteLLM profile, i.e. infra/litellm/<profile>.yaml: ollama (default, free) | anthropic | mixed
# (aws, section 12, is not written yet). Also used by `make models`.
LLM_PROFILE=ollama
# Ollama runs natively on the host by default; with the Compose profile `ollama`
# (docker compose --profile ollama ...) set it to http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Only for the anthropic and mixed profiles. An API key from the Claude Console.
ANTHROPIC_API_KEY=
# The agent service talks to LiteLLM, never to a provider directly.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-dev

# --- Agent service -----------------------------------------------------------
# Native runs only (Compose sets its own, pointing at the `postgres` container).
# The port must match POSTGRES_PORT below: change them together.
DATABASE_URL=postgresql://app:app@localhost:5432/app
BANKING_API_URL=http://localhost:8080
AUTO_INVESTIGATE_TYPES=card_decline,missed_payment,failed_direct_debit
# 1 for the ollama profile, 3 with Claude
MAX_PARALLEL_INVESTIGATIONS=1
# Enables the customer simulator and the /simulation endpoints. The code default
# is false; this local file turns it on.
SIMULATION_ENABLED=true
# Triage below this confidence returns `other`
TRIAGE_CONFIDENCE_THRESHOLD=0.6
# Timeout of one LLM call through LiteLLM, in seconds (default 120)
LLM_TIMEOUT_SECONDS=120
# Retries of a failed LLM call (default 2)
LLM_MAX_RETRIES=2
# Timeout of one banking API call, in seconds (default 10)
BANKING_TIMEOUT_SECONDS=10
# Comma-separated origins allowed by CORS (default: the two Angular dev servers)
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
# Knowledge base folder, relative to agent-service/ (default ../knowledge-base;
# in Compose it is /app/knowledge-base)
KB_PATH=../knowledge-base
# Ingests (embeds) the knowledge base articles at startup (default true)
KB_INGEST_ON_STARTUP=true
# Base URL of article links shown to customers (default /help/)
KB_ARTICLE_BASE_URL=/help/
# Embedding model for the knowledge base; must be 384-dimensional
# (default BAAI/bge-small-en-v1.5)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Runs the Alembic migrations at startup (default true)
MIGRATE_ON_STARTUP=true
# Enables the Postgres integration tests (pytest -m integration). Use a separate
# database: the tests wipe it. Unset by default.
# TEST_DATABASE_URL=postgresql://app:app@localhost:5432/app_test

# --- Banking service ---------------------------------------------------------
# `simulation` enables the simulation module (/simulation/incidents)
SPRING_PROFILES_ACTIVE=simulation
# Native runs only (Compose sets its own). The port must match POSTGRES_PORT
# below: change them together.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/app
SPRING_DATASOURCE_USERNAME=app
SPRING_DATASOURCE_PASSWORD=app
# Seeds the demo customers when the database is empty (default true)
BANKING_SEED_ENABLED=true

# --- Postgres (app database, pgvector) -----------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Host port of the app Postgres in Compose (change if a local Postgres already uses
# 5432). Natively run apps reach Postgres on this port, so change the port in
# DATABASE_URL and SPRING_DATASOURCE_URL above to the same value.
POSTGRES_PORT=5432

# --- Langfuse (self-hosted) --------------------------------------------------
LANGFUSE_HOST=http://localhost:3000
# Project API keys. infra/scripts/langfuse-setup.sh generates them (run by `make up`
# and `make infra`); langfuse-web creates its project with them on first start.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Admin login created on first start (also filled by the setup script)
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
# Langfuse's internal secrets (filled with random values by the setup script; when
# empty, Compose falls back to fixed local-dev values). Do not change
# LANGFUSE_ENCRYPTION_KEY after the first start.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
# Passwords of Langfuse's own stores (local only; empty = Compose defaults)
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=

{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:customer": "ng serve customer-app",
    "start:ops": "ng serve ops-console",
    "start:customer:real": "ng serve customer-app --configuration real",
    "start:ops:real": "ng serve ops-console --configuration real",
    "build": "ng build customer-app && ng build ops-console",
    "build:real": "ng build customer-app --configuration real && ng build ops-console --configuration real",
    "test": "npm run test:lib && npm run test:customer && npm run test:ops",
    "test:lib": "vitest run --config projects/api-client/vitest.config.ts",
    "test:customer": "ng test customer-app --watch=false",
    "test:ops": "ng test ops-console --watch=false"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "~4.0.18",
    "yaml": "^2.9.1"
  }
}
